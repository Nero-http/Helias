
---
const steps = [
  {
    number: "01",
    title: "Discover",
    description: "We understand the idea, identify the goals, and explore possibilities."
  },
  {
    number: "02",
    title: "Plan",
    description: "We organize the direction, define the approach, and prepare the foundation."
  },
  {
    number: "03",
    title: "Create",
    description: "We bring concepts to life through design, creativity, and development."
  },
  {
    number: "04",
    title: "Refine",
    description: "We review, improve, and polish every detail before the final result."
  }
];
---

<section id="process" class="process section">
  <div class="container">
    <div class="process-heading">
      <div>
        <p class="section-label">02 / HOW WE WORK</p>
        <h2>From concept<br />to <span>creation.</span></h2>
      </div>
      <p class="process-intro">
        A thoughtful process turns creative ideas into meaningful digital experiences.
      </p>
    </div>

    <div class="process-grid">
      {steps.map((step) => (
        <article class="process-item">
          <div class="process-top">
            <span>{step.number}</span>
            <span class="process-symbol" aria-hidden="true"></span>
          </div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.process {
  background: var(--bg);
}

.process-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 32px;
  margin-bottom: clamp(40px, 6vw, 68px);
}

.section-label {
  color: var(--accent);
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 700;
  margin: 0 0 20px;
}

.process-heading h2 {
  color: var(--text);
  font-family: var(--font-heading);
  font-size: clamp(2.8rem, 6.5vw, 5.5rem);
  line-height: 1;
  letter-spacing: -0.055em;
  margin: 0;
}

.process-heading h2 span {
  color: var(--accent);
}

.process-intro {
  max-width: 390px;
  color: var(--muted);
  line-height: 1.75;
  margin: 0 0 4px;
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.process-item {
  min-width: 0;
  padding: 0 clamp(16px, 2.2vw, 28px);
  border-left: 1px solid var(--border);
}

.process-top {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--accent);
  font-size: 11px;
  margin-bottom: clamp(32px, 4vw, 48px);
}

.process-top::before {
  position: absolute;
  z-index: 0;
  top: 50%;
  left: 0;
  right: -1px;
  height: 1px;
  background: var(--border);
  content: "";
}

.process-item:last-child .process-top::before {
  right: 0;
}

.process-top > span {
  position: relative;
  z-index: 1;
  background: var(--bg);
}

.process-top > span:first-child {
  padding-right: 12px;
}

.process-symbol {
  width: 8px;
  height: 8px;
  display: block;
  border: 0;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 5px var(--bg), 0 0 0 6px var(--border);
}

.process-item h3 {
  color: var(--text);
  font-family: var(--font-heading);
  font-size: clamp(1.25rem, 2vw, 1.5rem);
  margin: 0 0 10px;
}

.process-item p {
  color: var(--muted);
  line-height: 1.8;
  margin: 0;
}

@media (max-width: 760px) {
  .process-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 16px;
  }

  .process-grid {
    grid-template-columns: repeat(2, 1fr);
    row-gap: 38px;
  }

  .process-item:nth-child(odd) {
    padding-left: 0;
  }
}

@media (max-width: 520px) {
  .process-grid {
    grid-template-columns: 1fr;
    row-gap: 28px;
  }

  .process-item,
  .process-item:nth-child(odd) {
    padding: 0;
  }

  .process-top {
    margin-bottom: 22px;
  }
}
</style>
