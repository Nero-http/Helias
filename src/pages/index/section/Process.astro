
---
const steps = [
  {
    number: "01",
    title: "Discover",
    description: "We understand the idea, identify the goals, and explore possibilities."
  },
  {
    number: "02",
    title: "Plan",
    description: "We organize the direction, define the approach, and prepare the foundation."
  },
  {
    number: "03",
    title: "Create",
    description: "We bring concepts to life through design, creativity, and development."
  },
  {
    number: "04",
    title: "Refine",
    description: "We review, improve, and polish every detail before the final result."
  }
];
---

<section id="process" class="process section">
  <div class="container">
    <div class="process-heading" data-scroll-target>
      <div>
        <p class="section-label">02 / HOW WE WORK</p>
        <h2>From concept<br />to <span>creation.</span></h2>
      </div>
      <p class="process-intro">
        A thoughtful process turns creative ideas into meaningful digital experiences.
      </p>
    </div>

    <div class="process-grid">
      {steps.map((step) => (
        <article class="process-item">
          <div class="process-top">
            <span>{step.number}</span>
            <span class="process-symbol" aria-hidden="true"></span>
          </div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.process {
  background: var(--bg);
}

.process-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28.8px;
  margin-bottom: clamp(28.8px, 4.5vw, 50.4px);
}

.section-label {
  color: var(--accent);
  font-size: 8.8px;
  letter-spacing: 1.75px;
  font-weight: 700;
  margin: 0 0 18px;
}

.process-heading h2 {
  color: var(--text);
  font-family: var(--font-heading);
  font-size: clamp(2.72rem, 5.24vw, 4.61rem);
  line-height: 1;
  letter-spacing: -0.055em;
  margin: 0;
}

.process-heading h2 span {
  color: var(--accent);
}

.process-intro {
  max-width: 390px;
  color: var(--muted);
  line-height: 1.75;
  margin: 0 0 4px;
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.process-item {
  min-width: 0;
  padding: 0 clamp(14.4px, 2.2vw, 25.2px);
  border-left: 1px solid var(--border);
}

.process-top {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--accent);
  font-size: 9.63px;
  margin-bottom: clamp(28.8px, 4vw, 43.2px);
}

.process-top::before {
  position: absolute;
  z-index: 0;
  top: 50%;
  left: 0;
  right: -1px;
  height: 1px;
  background: var(--border);
  content: "";
}

.process-item:last-child .process-top::before {
  right: 0;
}

.process-top > span {
  position: relative;
  z-index: 1;
  background: var(--bg);
}

.process-top > span:first-child {
  padding-right: 10.8px;
}

.process-symbol {
  width: 7px;
  height: 7px;
  display: block;
  border: 0;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 4.41px var(--bg), 0 0 0 5.22px var(--border);
}

.process-item h3 {
  color: var(--text);
  font-family: var(--font-heading);
  font-size: clamp(1.21rem, 1.94vw, 1.46rem);
  margin: 0 0 9px;
}

.process-item p {
  color: var(--muted);
  line-height: 1.8;
  margin: 0;
}

@media (max-width: 760px) {
  .process-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 16px;
  }

  .process-grid {
    grid-template-columns: repeat(2, 1fr);
    row-gap: 34.2px;
  }

  .process-item:nth-child(odd) {
    padding-left: 0;
  }
}

@media (max-width: 520px) {
  .process-grid {
    grid-template-columns: 1fr;
    row-gap: 25.2px;
  }

  .process-item,
  .process-item:nth-child(odd) {
    padding: 0;
  }

  .process-top {
    margin-bottom: 19.8px;
  }
}
</style>
