
---
const services = [
  {
    number: "01",
    title: "Game Development",
    description: "Building interactive games with engaging mechanics and memorable experiences."
  },
  {
    number: "02",
    title: "Character Design",
    description: "Creating distinctive characters with personality, identity, and visual depth."
  },
  {
    number: "03",
    title: "World Building",
    description: "Designing environments that bring fictional worlds to life."
  },
  {
    number: "04",
    title: "Creative Direction",
    description: "Developing cohesive visual concepts and creative ideas for game projects."
  }
];
---

<section class="services section" id="services">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">WHAT WE DO / 01</span>
      <h2>Our expertise<span>.</span></h2>
      <p>Creative services built around interactive experiences and visual storytelling.</p>
    </div>

    <div class="service-list">
      {services.map((service) => (
        <article class="service-item">
          <span class="service-number">{service.number}</span>

          <h3>{service.title}</h3>

          <p>{service.description}</p>

          <span class="service-arrow">↗</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--surface);
  }

  .section-heading {
    max-width: 560px;
    margin-bottom: 50px;
  }

  .section-label {
    color: var(--accent);
    font-size: 9px;
    letter-spacing: 1.7px;
  }

  .section-heading h2 {
    margin: 15px 0;
    color: var(--text);
    font-family: var(--font-heading);
    font-size: clamp(34px, 5vw, 48px);
    font-weight: 500;
    letter-spacing: -2px;
  }

  .section-heading h2 span {
    color: var(--accent);
  }

  .section-heading p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
  }

  .service-item {
    display: grid;
    grid-template-columns: 60px 1fr 1.1fr 25px;
    align-items: center;
    gap: 25px;
    padding: 25px 0;
    border-top: 1px solid var(--border);
  }

  .service-number {
    color: var(--accent);
    font-size: 10px;
  }

  .service-item h3 {
    color: var(--text);
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 500;
  }

  .service-item p {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.7;
  }

  .service-arrow {
    color: var(--accent);
    text-align: right;
    font-size: 17px;
  }

  .service-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 650px) {
    .service-item {
      grid-template-columns: 35px 1fr 20px;
      gap: 12px;
    }

    .service-item h3 {
      font-size: 15px;
    }

    .service-item p {
      grid-column: 2;
      grid-row: 2;
    }

    .service-arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
