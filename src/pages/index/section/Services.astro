
---
const services = [
  {
    number: "01",
    title: "Creative Editing",
    description: "Turning raw ideas and content into polished visual experiences."
  },
  {
    number: "02",
    title: "Development",
    description: "Building functional digital solutions through thoughtful development."
  },
  {
    number: "03",
    title: "Web Development",
    description: "Creating responsive, modern, and user-friendly websites."
  },
  {
    number: "04",
    title: "Digital Design",
    description: "Designing visual identities and interfaces with purpose."
  }
];

const skills = ["C++", "HTML", "CSS", "Astro", "JavaScript", "PHP", "TypeScript", "GSAP"];
---

<section id="services" class="services section">
  <div class="container">
    <div class="section-heading" data-scroll-target>
      <div>
        <p class="section-label">01 / WHAT WE DO</p>
        <h2>Our <span>expertise.</span></h2>
      </div>
      <p class="section-intro">
        Different skills. One creative direction.
        We bring ideas to life through design and technology.
      </p>
    </div>

    <div class="service-list">
      {services.map((service) => (
        <article class="service-item">
          <span class="service-number">{service.number}</span>
          <div class="service-main">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
          <span class="service-arrow" aria-hidden="true">↗</span>
        </article>
      ))}
    </div>

    <div class="skills">
      <h3>Technical Skills</h3>
      <ul class="skill-list">
        {skills.map((skill) => <li class="technical-skill">{skill}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
.services {
  background: var(--bg);
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28.8px;
  margin-bottom: clamp(28.8px, 4vw, 43.2px);
}

.section-label {
  color: var(--accent);
  font-size: 8.8px;
  letter-spacing: 1.75px;
  font-weight: 700;
  margin: 0 0 16.2px;
}

.section-heading h2 {
  color: var(--text);
  font-family: var(--font-heading);
  font-size: clamp(2.43rem, 5.82vw, 4.61rem);
  line-height: 1.02;
  letter-spacing: -0.055em;
  margin: 0;
}

.section-heading h2 span {
  color: var(--muted);
}

.section-intro {
  max-width: 288px;
  color: var(--muted);
  line-height: 1.75;
  margin: 0 0 3.6px;
}

.service-list {
  border-top: 1px solid var(--border);
}

.skills {
  margin-top: clamp(32.4px, 4vw, 50.4px);
}

.skills h3 {
  color: var(--text);
  font-family: var(--font-heading);
  font-size: clamp(1.16rem, 2.43vw, 1.7rem);
  margin: 0 0 18px;
}

.skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10.8px;
  padding: 0;
  margin: 0;
  list-style: none;
}

.skill-list li {
  padding: 8.73px 13.95px;
  border: 1px solid var(--border);
  color: var(--muted);
  font-size: 11.34px;
  transition:
    color 0.25s ease,
    border-color 0.25s ease,
    background-color 0.25s ease,
    box-shadow 0.25s ease,
    transform 0.25s ease;
}

.skill-list li:hover {
  color: var(--text);
  border-color: var(--accent);
  background: var(--surface);
  box-shadow: 0 0 18px rgba(0, 239, 80, 0.16);
  transform: translateY(-3px) scale(1.02);
}

.service-item {
  display: grid;
  grid-template-columns: 45.45px minmax(0, 1fr) 27.9px;
  align-items: center;
  gap: clamp(10.8px, 2vw, 21.6px);
  padding: clamp(19.35px, 1.94vw, 24.48px) 13.95px;
  border-bottom: 1px solid var(--border);
  transition: background-color 0.25s ease, padding 0.25s ease;
}

.service-item:hover {
  padding-inline: 21.6px 10.8px;
  background: var(--surface);
}

.service-number {
  color: var(--accent);
  font-size: 9.63px;
  letter-spacing: 1px;
}

.service-main h3 {
  color: var(--text);
  font-family: var(--font-heading);
  font-size: clamp(1.16rem, 2.43vw, 1.7rem);
  line-height: 1.2;
  margin: 0 0 6px;
}

.service-main p {
  color: var(--muted);
  line-height: 1.7;
  margin: 0;
}

.service-arrow {
  color: var(--muted);
  font-size: 17.55px;
  transition: color 0.25s ease, transform 0.25s ease;
}

.service-item:hover .service-arrow {
  color: var(--accent);
  transform: translate(4px, -4px);
}

@media (max-width: 640px) {
  .section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 16px;
  }

  .service-item {
    grid-template-columns: 27.9px minmax(0, 1fr) 17.55px;
    padding-inline: 3.6px;
  }

  .service-item:hover {
    padding-inline: 9px 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .skill-list li:hover {
    box-shadow: none;
    transform: none;
  }
}
</style>
