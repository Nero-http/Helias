
---
const services = [
  {
    number: "01",
    title: "Creative Editing",
    description: "Turning raw ideas and content into polished visual experiences."
  },
  {
    number: "02",
    title: "Development",
    description: "Building functional digital solutions through thoughtful development."
  },
  {
    number: "03",
    title: "Web Development",
    description: "Creating responsive, modern, and user-friendly websites."
  },
  {
    number: "04",
    title: "Digital Design",
    description: "Designing visual identities and interfaces with purpose."
  }
];
---

<section id="services" class="services section">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="section-label">01 / WHAT WE DO</p>
        <h2>Our <span>expertise.</span></h2>
      </div>
      <p class="section-intro">
        Different skills. One creative direction.
        We bring ideas to life through design and technology.
      </p>
    </div>

    <div class="service-list">
      {services.map((service) => (
        <article class="service-item">
          <span class="service-number">{service.number}</span>
          <div class="service-main">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
          <span class="service-arrow" aria-hidden="true">↗</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.services {
  background: var(--bg);
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 32px;
  margin-bottom: clamp(36px, 5vw, 60px);
}

.section-label {
  color: var(--accent);
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 700;
  margin: 0 0 18px;
}

.section-heading h2 {
  color: var(--text);
  font-family: var(--font-heading);
  font-size: clamp(2.5rem, 6vw, 4.75rem);
  line-height: 1.02;
  letter-spacing: -0.055em;
  margin: 0;
}

.section-heading h2 span {
  color: var(--muted);
}

.section-intro {
  max-width: 320px;
  color: var(--muted);
  line-height: 1.75;
  margin: 0 0 4px;
}

.service-list {
  border-top: 1px solid var(--border);
}

.service-item {
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) 32px;
  align-items: center;
  gap: clamp(12px, 2vw, 24px);
  padding: clamp(22px, 3vw, 32px) 16px;
  border-bottom: 1px solid var(--border);
  transition: background-color 0.25s ease, padding 0.25s ease;
}

.service-item:hover {
  padding-inline: 24px 12px;
  background: var(--surface);
}

.service-number {
  color: var(--accent);
  font-size: 11px;
  letter-spacing: 1px;
}

.service-main h3 {
  color: var(--text);
  font-family: var(--font-heading);
  font-size: clamp(1.2rem, 2.5vw, 1.75rem);
  line-height: 1.2;
  margin: 0 0 6px;
}

.service-main p {
  color: var(--muted);
  line-height: 1.7;
  margin: 0;
}

.service-arrow {
  color: var(--muted);
  font-size: 20px;
  transition: color 0.25s ease, transform 0.25s ease;
}

.service-item:hover .service-arrow {
  color: var(--accent);
  transform: translate(4px, -4px);
}

@media (max-width: 640px) {
  .section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 16px;
  }

  .service-item {
    grid-template-columns: 32px minmax(0, 1fr) 20px;
    padding-inline: 4px;
  }

  .service-item:hover {
    padding-inline: 10px 0;
  }
}
</style>
