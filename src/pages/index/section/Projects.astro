---
const skillGroups = [
  {
    title: "Technical Skills",
    images: [
      {
        src: "/image/skills/technical-skills-1.png",
        alt: "Hardware store website design",
        description:
          "A neighborhood hardware store website presenting its products and services."
      },
      {
        src: "/image/skills/technical-skills-2.png",
        alt: "Pharmacy prescription system website design",
        description:
          "A web-based pharmacy system for managing patients, medicines, and prescriptions."
      }
    ]
  },
  {
    title: "Non-Technical Skills",
    images: [
      {
        src: "/image/skills/non-technical-skills-1.png",
        alt: "Computer studies jersey design mockup",
        description:
          "A front-and-back jersey mockup created for a computer studies identity."
      },
      {
        src: "/image/skills/non-technical-skills-2.png",
        alt: "Figma interface and prototype design",
        description:
          "A Figma prototype connecting laptop detail and reservation screens."
      },
      {
        src: "/image/skills/non-technical-skills-3.png",
        alt: "Teacher's Day poster design",
        description:
          "A warm, classroom-inspired poster celebrating Teacher's Day."
      }
    ]
  }
];
---

<section id="projects" class="projects section">
  <div class="container">
    <div class="projects-heading">
      <div>
        <p class="section-label">04 / SKILLS & WORK</p>
        <h2>Skills in <span>action.</span></h2>
      </div>
      <p class="projects-intro">
        A selection of technical projects and creative work.
      </p>
    </div>

    {skillGroups.map((group) => (
      <div class="skill-group">
        <h3>{group.title}</h3>
        <div class="skill-image-grid">
          {group.images.map((image) => (
            <figure class="skill-image">
              <img src={image.src} alt={image.alt} loading="lazy" />
              <figcaption>{image.description}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .projects {
    background: var(--surface);
  }

  .projects-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .section-label {
    color: var(--accent);
    font-size: 10px;
    letter-spacing: 2px;
    font-weight: 700;
    margin: 0 0 18px;
  }

  .projects-heading h2 {
    color: var(--text);
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    letter-spacing: -0.055em;
    line-height: 1;
    margin: 0;
  }

  .projects-heading h2 span {
    color: var(--accent);
  }

  .projects-intro {
    color: var(--muted);
    max-width: 310px;
    line-height: 1.75;
    margin: 0 0 4px;
  }

  .skill-group + .skill-group {
    margin-top: 52px;
  }

  .skill-group h3 {
    color: var(--text);
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    margin: 0 0 20px;
  }

  .skill-image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(16px, 2.5vw, 28px);
  }

  .skill-image {
    min-width: 0;
    overflow: hidden;
    background: var(--surface-light);
    border: 1px solid var(--border);
  }

  .skill-image img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    transition: transform 0.5s ease;
  }

  .skill-image:hover img {
    transform: scale(1.035);
  }

  .skill-image figcaption {
    padding: 14px 16px 16px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.65;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 900px) {
    .projects-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
