
---
const projects = [
  {
    number: "01",
    title: "Digital Environments",
    category: "ENVIRONMENT / VISUAL CONCEPT",
    description: "Exploring atmosphere, composition, and immersive digital spaces.",
    image: "https://i.pinimg.com/1200x/8e/40/4a/8e404aed59d8b7e1caade6a26514cc42.jpg"
  },
  {
    number: "02",
    title: "Visual Concepts",
    category: "CREATIVE / DIGITAL DESIGN",
    description: "A study of visual direction, aesthetics, and creative expression.",
    image: "https://i.pinimg.com/736x/0b/4b/19/0b4b193422503575d7fb6bd73d1f0bdb.jpg"
  },
  {
    number: "03",
    title: "Creative Worlds",
    category: "ART / WORLD BUILDING",
    description: "Imagining unique worlds through digital creativity and design.",
    image: "https://i.pinimg.com/736x/c3/1d/d2/c31dd2a3db4568d165afea1ac2e08b2b.jpg"
  }
];
---

<section id="projects" class="projects section">
  <div class="container">
    <div class="projects-heading">
      <div>
        <p class="section-label">04 / SELECTED WORK</p>
        <h2>Ideas made <span>visible.</span></h2>
      </div>
      <p class="projects-intro">
        A collection of creative explorations, visual concepts, and inspiration.
      </p>
    </div>

    <div class="project-grid">
      {projects.map((project) => (
        <article class="project-card">
          <div class="project-image">
            <img src={project.image} alt={project.title} loading="lazy" />
            <span class="project-number">{project.number}</span>
            <span class="project-open" aria-hidden="true">↗</span>
          </div>

          <div class="project-info">
            <div>
              <p>{project.category}</p>
              <h3>{project.title}</h3>
              <span class="project-description">{project.description}</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="project-note">
      SELECTED CREATIVE EXPLORATIONS — VISUAL REFERENCES AND CONCEPTS.
    </p>
  </div>
</section>

<style>
.projects {
  background: var(--surface);
}

.projects-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 32px;
  margin-bottom: clamp(36px, 5vw, 56px);
}

.section-label {
  color: var(--accent);
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 700;
  margin: 0 0 18px;
}

.projects-heading h2 {
  color: var(--text);
  font-family: var(--font-heading);
  font-size: clamp(2.5rem, 6vw, 4.75rem);
  letter-spacing: -0.055em;
  line-height: 1;
  margin: 0;
}

.projects-heading h2 span {
  color: var(--accent);
}

.projects-intro {
  color: var(--muted);
  max-width: 310px;
  line-height: 1.75;
  margin: 0 0 4px;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(18px, 2.5vw, 30px);
}

.project-card {
  min-width: 0;
}

.project-large {
  grid-row: span 2;
}

.project-image {
  position: relative;
  aspect-ratio: 1.08;
  overflow: hidden;
  background: var(--bg);
}

.project-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.65s ease, filter 0.65s ease;
  filter: saturate(0.82);
}

.project-card:hover .project-image img {
  transform: scale(1.035);
  filter: saturate(1);
}

.project-number,
.project-open {
  position: absolute;
  top: 14px;
  color: #fff;
  font-size: 11px;
  text-shadow: 0 1px 10px rgba(0, 0, 0, 0.55);
}

.project-number {
  left: 14px;
}

.project-open {
  right: 14px;
  font-size: 18px;
  transition: color 0.25s ease, transform 0.25s ease;
}

.project-card:hover .project-open {
  color: var(--accent);
  transform: translate(3px, -3px);
}

.project-info {
  display: flex;
  justify-content: space-between;
  padding: 17px 0;
  border-bottom: 1px solid var(--border);
}

.project-info p {
  color: var(--accent);
  font-size: 9px;
  letter-spacing: 1.5px;
  margin: 0 0 8px;
}

.project-info h3 {
  color: var(--text);
  font-family: var(--font-heading);
  font-size: clamp(1.15rem, 1.8vw, 1.45rem);
  margin: 0 0 7px;
}

.project-description {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.65;
}

.project-note {
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 1.5px;
  margin: 32px 0 0;
}

@media (max-width: 900px) {
  .projects-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 16px;
  }

  .project-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 560px) {
  .project-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .project-image {
    aspect-ratio: 1.2;
  }
}
</style>
