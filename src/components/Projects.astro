
---
import { assets } from "../data/assets";

const projects = [
  {
    number: "01",
    title: "World of Fantasy",
    category: "Environment Design",
    image: assets.environments[0]
  },
  {
    number: "02",
    title: "Ancient Realms",
    category: "World Building",
    image: assets.environments[1]
  },
  {
    number: "03",
    title: "Mystic Landscapes",
    category: "Environment Art",
    image: assets.environments[2]
  }
];
---

<section class="projects section" id="projects">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">SELECTED WORK / 04</span>
      <h2>Our projects<span>.</span></h2>
      <p>A collection of creative concepts and visual explorations from HELIAS Studio.</p>
    </div>

    <div class="projects-grid">
      {projects.map((project) => (
        <article class="project-card">
          <div class="project-image">
            <img
              src={project.image}
              alt={project.title}
              loading="lazy"
            />
            <span>{project.number}</span>
          </div>

          <div class="project-info">
            <div>
              <h3>{project.title}</h3>
              <p>{project.category}</p>
            </div>
            <span class="project-arrow">↗</span>
          </div>
        </article>
      ))}
    </div>

    <div class="projects-footer">
      <span>MORE IDEAS. MORE WORLDS.</span>
      <a href="#contact">START A PROJECT ↗</a>
    </div>
  </div>
</section>

<style>
  .projects {
    background: var(--bg);
  }

  .section-heading {
    max-width: 560px;
    margin-bottom: 45px;
  }

  .section-label {
    color: var(--accent);
    font-size: 9px;
    letter-spacing: 1.7px;
  }

  .section-heading h2 {
    margin: 15px 0;
    color: var(--text);
    font-family: var(--font-heading);
    font-size: clamp(35px, 5vw, 48px);
    font-weight: 500;
    letter-spacing: -2px;
  }

  .section-heading h2 span {
    color: var(--accent);
  }

  .section-heading p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .project-image {
    position: relative;
    height: 280px;
    overflow: hidden;
    background: #111;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .project-card:hover img {
    transform: scale(1.035);
  }

  .project-image > span {
    position: absolute;
    top: 13px;
    left: 13px;
    color: white;
    font-size: 10px;
  }

  .project-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 17px 0;
    border-bottom: 1px solid var(--border);
  }

  .project-info h3 {
    color: var(--text);
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 500;
  }

  .project-info p {
    margin-top: 5px;
    color: var(--muted);
    font-size: 10px;
  }

  .project-arrow {
    color: var(--accent);
    font-size: 18px;
    transition: transform 0.3s ease;
  }

  .project-card:hover .project-arrow {
    transform: translate(3px, -3px);
  }

  .projects-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 30px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1.3px;
  }

  .projects-footer a {
    color: var(--accent);
  }

  @media (max-width: 800px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 550px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-image {
      height: 250px;
    }

    .projects-footer {
      flex-direction: column;
    }
  }
</style>
