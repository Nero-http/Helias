
---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-main">
      <a href="#home" class="footer-brand">
        <img src="/image/logo.png" alt="Helias Logo" />
        <span>HELIAS<span>.</span></span>
      </a>

      <p>
        A creative digital development team<br />
        driven by ideas, technology, and design.
      </p>

      <a href="#home" class="back-top">BACK TO TOP ↑</a>
    </div>

    <div class="footer-bottom">
      <span>© {currentYear} HELIAS. ALL RIGHTS RESERVED.</span>
      <span>BUILT WITH CREATIVITY.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 55px 0 22px;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .footer-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding-bottom: 45px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font: 700 19px var(--font-heading);
    letter-spacing: 1.5px;
  }

  .footer-brand img {
    width: 34px;
    height: 34px;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  html[data-theme="light"] .footer-brand img {
    filter: brightness(0);
  }

  .footer-brand span span { color: var(--accent); }

  .footer-main p {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.8;
  }

  .back-top {
    color: var(--text);
    font-size: 10px;
    letter-spacing: 1px;
  }

  .back-top:hover { color: var(--accent); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1px;
  }

  @media (max-width: 600px) {
    .footer-main {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
