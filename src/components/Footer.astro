
---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-main">
      <a href="#home" class="footer-brand">
        <img src="/image/logo.png" alt="Helias Logo" />
        <span>HELIAS<span>.</span></span>
      </a>

      <p>
        A creative digital development team<br />
        driven by ideas, technology, and design.
      </p>

      <a href="#home" class="back-top">BACK TO TOP ↑</a>
    </div>

    <div class="footer-bottom">
      <span>© {currentYear} HELIAS. ALL RIGHTS RESERVED.</span>
      <span>BUILT WITH CREATIVITY.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(36px, 4vw, 50.4px) 0 18px;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .footer-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22.5px;
    padding-bottom: clamp(25.2px, 3vw, 32.4px);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
    font: 700 16.65px var(--font-heading);
    letter-spacing: 1.35px;
  }

  .footer-brand img {
    width: 29.7px;
    height: 29.7px;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  html[data-theme="light"] .footer-brand img {
    filter: brightness(0);
  }

  .footer-brand span span { color: var(--accent); }

  .footer-main p {
    max-width: 252px;
    margin: 0;
    color: var(--muted);
    font-size: 9.63px;
    line-height: 1.8;
  }

  .back-top {
    color: var(--text);
    font-size: 8.82px;
    letter-spacing: 0.9px;
  }

  .back-top:hover { color: var(--accent); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 7.92px;
    letter-spacing: 0.9px;
  }

  @media (max-width: 600px) {
    .footer-main {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 9px;
    }
  }
</style>
