
---
const steps = [
  {
    number: "01",
    title: "Discover",
    description: "We understand the idea, goals, and direction of the project."
  },
  {
    number: "02",
    title: "Design",
    description: "We develop concepts, visuals, and the creative foundation."
  },
  {
    number: "03",
    title: "Develop",
    description: "We turn concepts into interactive experiences."
  },
  {
    number: "04",
    title: "Deliver",
    description: "We refine the work and prepare the final experience."
  }
];
---

<section class="process section" id="process">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">HOW WE WORK / 02</span>
      <h2>From idea to reality<span>.</span></h2>
      <p>A straightforward creative process that keeps every project moving.</p>
    </div>

    <div class="process-grid">
      {steps.map((step) => (
        <article class="process-item">
          <span class="process-number">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .process {
    background: var(--bg);
  }

  .section-heading {
    max-width: 560px;
    margin-bottom: 50px;
  }

  .section-label {
    color: var(--accent);
    font-size: 9px;
    letter-spacing: 1.7px;
  }

  .section-heading h2 {
    margin: 15px 0;
    color: var(--text);
    font-family: var(--font-heading);
    font-size: clamp(34px, 5vw, 48px);
    font-weight: 500;
    letter-spacing: -2px;
  }

  .section-heading h2 span {
    color: var(--accent);
  }

  .section-heading p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--border);
  }

  .process-item {
    padding: 25px 22px 20px 0;
    border-right: 1px solid var(--border);
  }

  .process-item:not(:first-child) {
    padding-left: 22px;
  }

  .process-item:last-child {
    border-right: 0;
  }

  .process-number {
    color: var(--accent);
    font-size: 10px;
  }

  .process-item h3 {
    margin: 40px 0 12px;
    color: var(--text);
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 500;
  }

  .process-item p {
    max-width: 230px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.8;
  }

  @media (max-width: 700px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-item {
      padding: 22px 15px 22px 0;
      border-bottom: 1px solid var(--border);
    }

    .process-item:not(:first-child) {
      padding-left: 15px;
    }

    .process-item:nth-child(2) {
      border-right: 0;
    }

    .process-item:nth-child(3) {
      padding-left: 0;
    }

    .process-item h3 {
      margin-top: 25px;
    }
  }
</style>
