
---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "HELIAS | Creative Digital Studio",
  description = "HELIAS is a creative digital studio building thoughtful web experiences through design, development, and technology."
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />

    <!-- Load saved theme before displaying the page -->
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("helias-theme");

        if (savedTheme === "light" || savedTheme === "dark") {
          document.documentElement.dataset.theme = savedTheme;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", savedTheme === "light" ? "#f7f7f5" : "#050505");
        }
      } catch {
        document.documentElement.dataset.theme = "dark";
      }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body>
    <div id="progressBar"></div>

    <slot />

    <!-- GSAP Animations -->
    <script>
      import "../scripts/animation.js";
    </script>
  </body>
</html>
